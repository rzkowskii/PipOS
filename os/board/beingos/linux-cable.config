# Kernel options for the cable development build only (BEING_LAPTOP_CABLE=1
# lab/build.sh laptop-try), on top of linux.config and linux-laptop.config.
# Release laptop and lab kernels never carry them.
#
# The HD-audio codec's hwdep node (/dev/snd/hwC0D0) and its sysfs
# reconfiguration files (hints, init_pin_configs, user_pin_configs,
# reconfig), so pip-diag can try another codec fixup, pin or coefficient
# over the cable without a reboot; and ALSA's debug messages, so dmesg names
# the fixup the codec driver picked.
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_PATCH_LOADER=y
CONFIG_SND_DEBUG=y
CONFIG_SND_DEBUG_VERBOSE=y
# Already in the laptop kernel, and needed by the cable link: IPv6 for its
# fe80::77:1 address, and cgroup BPF for being-cable-ssh.service's
# IPAddressAllow=/IPAddressDeny=. Stated here so the link never loses them
# silently.
CONFIG_IPV6=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
