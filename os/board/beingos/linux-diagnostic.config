# WP-C8 maintenance kernel options. This fragment is appended only by
# BEING_LAPTOP_DIAGNOSTIC=1 and must never enter laptop release/update trees.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_FS=y
CONFIG_LKDTM=m
CONFIG_X86_MSR=y

# Read-only WP-E10 qualification can measure an already verity-enabled model
# asset.  This diagnostic option does not enable verity on any file and is
# deliberately absent from the product kernel until provisioning is designed.
CONFIG_FS_VERITY=y

# perf's Buildroot package adds its own required fixups; state the measurement
# facilities here as evidence that this kernel is intentionally diagnostic.
CONFIG_PERF_EVENTS=y
