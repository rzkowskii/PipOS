#!/bin/sh
set -eu

IFS= read -r cmdline </proc/cmdline
set -f
for argument in $cmdline; do
    case "$argument" in
        being.try=1)
            echo "Updates require an installed PipOS system" >&2
            exit 1 ;;
        being.installed|being.installed=*)
            if [ "${RAUC_SYSTEM_CONFIG:-}" != /run/systemd/generator.early/being-installed/rauc.conf ]; then
                echo "Use the installed disk's RAUC service to update PipOS" >&2
                exit 1
            fi
            PYTHONPATH=/usr/lib/being PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -m mind.install_binding ;;
    esac
done

# During a trial boot, the inactive slot is the rollback copy.
if [ ! -f /run/being-slot-good ]; then
    echo "PipOS must finish its health check before installing an update" >&2
    exit 1
fi
