# PipOS kernel configuration, in defconfig form: anything not listed takes the
# kernel's default. One kernel serves the 2012 MacBook Pro and the QEMU lab
# machine. The laptop-only diet comes later.

# Core
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
# Control groups for the organs' sandboxes and Pip's workshop
# (docs/design/voice-apps.md section 5): the memory and pids controllers make
# MemoryMax= and TasksMax= real, PSI shows when memory or CPU is short, and
# cgroup BPF backs DeviceAllow= and IPAddressDeny= (systemd skips them
# silently without it). The cgroup v2 freezer needs no option.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_PSI=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_PRINTK_TIME=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_SMP=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Network
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# Load an inet firewall before device network services, on both IP families.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NETDEVICES=y
CONFIG_E1000E=y
CONFIG_TIGON3=y
CONFIG_VIRTIO_NET=y
CONFIG_WLAN=y
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
# Candidate for the internal BCM4331. Firmware is provisioned separately.
CONFIG_B43=m
CONFIG_B43_BUSES_BCMA=y
CONFIG_B43_PHY_HT=y

# Disks
CONFIG_PCI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_VIRTIO_BLK=y
CONFIG_USB_STORAGE=y

# Input
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_MOUSE_BCM5974=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_APPLE=y
CONFIG_VIRTIO_INPUT=y

# Serial line: the lab's maintenance port
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# The screen is the face: graphics, but no text console drawn on it
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
# CONFIG_DRM_FBDEV_EMULATION is not set
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Sound
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_ALOOP=m

# USB
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y

# The on-device camera detector reads the FaceTime HD UVC device through V4L2.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y

# Body: power, lid, sensors, watchdog, clock
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_SBS=m
# Use Intel's Ivy Bridge idle-state table when the hardware supports it.
CONFIG_INTEL_IDLE=y
CONFIG_HWMON=y
CONFIG_SENSORS_APPLESMC=y
CONFIG_SENSORS_CORETEMP=y
# Expose CPU package energy for tuning on the physical MacBook.
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=y
CONFIG_WATCHDOG=y
CONFIG_ITCO_WDT=y
CONFIG_I6300ESB_WDT=y
CONFIG_RTC_CLASS=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_TEST_POWER=m

# Virtual machine plumbing
CONFIG_VIRTIO_PCI=y
CONFIG_FW_CFG_SYSFS=y
CONFIG_VIRTIO_CONSOLE=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SQUASHFS=y
# Remove the intermediate copy and let concurrent boot reads decompress in parallel.
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI=y
CONFIG_EROFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AUTOFS_FS=y

# The MacBookPro9,2 xHCI controller (8086:1e31) has no legacy IRQ routed by
# Apple's firmware; without MSI it fails ("No msi-x/msi found and no IRQ in
# BIOS"), the USB stick never appears and the root filesystem cannot mount.
# QEMU's xHCI works on INTx, so the lab alone cannot catch this.
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
