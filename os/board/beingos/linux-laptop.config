# Laptop kernel: merged over linux.config by beingos_laptop_defconfig only.
# It removes every way in that exists for the QEMU lab, and the fake body
# drivers. The MacBookPro9,2 hardware (i915, HDA Cirrus, b43/bcma, tg3,
# applesmc, ACPI, UVC) is untouched, and a software watchdog stands in for
# the chipset's (below). Virtio disk and display stay so the image can
# still be smoke-booted in a plain VM.

# The lab's serial maintenance port and its console.
# CONFIG_SERIAL_8250 is not set
# CONFIG_SERIAL_8250_CONSOLE is not set

# QEMU firmware markers, the virtio voice/microphone port, virtio input and
# network, and the emulated watchdog and entropy source.
# CONFIG_FW_CFG_SYSFS is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_I6300ESB_WDT is not set

# Test-only drivers: a fabricated battery, a loopback sound card and
# injected input devices.
# CONFIG_TEST_POWER is not set
# CONFIG_SND_ALOOP is not set
# CONFIG_INPUT_UINPUT is not set

# A text console on the built-in panel, for the Try menu's "show boot
# messages" and "safe graphics" entries and for any panic. The lab keeps the
# screen graphics-only (linux.config). fbdev emulation is an in-kernel DRM
# client, not a DRM master: the face and being-console still become master
# and take the panel over through KMS. Deferred takeover keeps the quiet entry
# free of text until something is printed (an error or a panic).
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# The firmware's EFI framebuffer as a DRM device: the face's fallback screen
# under nomodeset (llvmpipe, as on the lab's bochs display) and the console
# until i915 replaces it.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# A panic is drawn over the face (i915 and simpledrm support it), with the
# last kernel messages, so a quiet first boot that dies is still readable.
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN="kmsg"

# /dev/cpu/*/msr, for battery-out mode (plan section 4, Mode B): clearing
# BD PROCHOT in MSR 0x1FC when no battery is present. A module, loaded at
# boot; writes stay refused (msr.allow_writes=off on the command line) until
# bodycare turns them on in that mode.
CONFIG_X86_MSR=m

# The watchdog systemd feeds (RuntimeWatchdogSec=30s, RebootWatchdogSec=2min
# in watchdog.conf). The Panther Point PCH's TCO watchdog (iTCO_wdt, built in
# by linux.config) cannot be used on the MacBookPro9,2: the firmware sets its
# NO_REBOOT strap and the driver gives up ("unable to reset NO_REBOOT flag,
# device disabled by hardware/BIOS", measured 25 November 2026), so there
# was no /dev/watchdog and systemd's setting guarded nothing. softdog is the
# supported fallback: a kernel timer that restarts the machine when PID 1
# stops feeding it, which also lets a hung trial slot fall back through the
# boot counter. It does not catch a kernel that hangs with interrupts off.
# iTCO_wdt stays built in: it registers before softdog on hardware where it
# works, and systemd opens the first watchdog (/dev/watchdog0).
CONFIG_SOFT_WATCHDOG=y
# The watchdog's sysfs attributes (/sys/class/watchdog/watchdog0/identity,
# timeout, state, timeleft), so pip-diag and the hardware report can show
# which watchdog systemd feeds and that it is armed; without them only the
# device node is there. Read-only: nothing writes them.
CONFIG_WATCHDOG_SYSFS=y

# Built-in SD reader on the MacBookPro9,2. PCI 14e4:16bc is the Broadcom
# BCM57765 SDXC function matched by the upstream sdhci-pci driver. Keep the
# stack built in so insertion/removal can be qualified without module loading.
# This only enumerates mmc block devices: Pip's removable-media verbs still
# accept USB explicitly and no service or fstab entry mounts an SD card.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y

# Idle power (plan item 15, cable deep dive 25 November 2026): the package
# reached deep C-states about 1% of the time near idle (7.9-9.1 W at 71-82 C).
# TODO(power-live-test): the Thunderbolt controller (Intel 8086:1513, bridge
# 04:00.0) has no driver beyond pcieport, so it stays powered with ASPM L1
# off. CONFIG_THUNDERBOLT would bind it and let runtime PM power it down,
# but whether this Mac's firmware lets it, and whether it saves anything,
# is unmeasured; power-live-test.sh measures the bridge's runtime PM first
# (step driverless-pci-auto). Add `CONFIG_THUNDERBOLT=y` only if it HELPS.
