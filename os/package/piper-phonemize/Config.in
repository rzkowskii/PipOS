config BR2_PACKAGE_PIPER_PHONEMIZE
	bool "piper-phonemize"
	default y if BR2_PACKAGE_SHERPA_ONNX
	depends on BR2_x86_64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  Piper's phonemizer, for the natural voice. sherpa-onnx 2.0
	  and later no longer contain espeak-ng, so a Piper voice needs
	  its text turned into phonemes first; mind/phonemize.py loads
	  this library through ctypes and passes the result to
	  sherpa-onnx as phoneme codepoints.

	  This installs the upstream prebuilt linux-x64-shared release
	  (libpiper_phonemize_core.so, with espeak-ng linked statically
	  and its symbols hidden), pinned by sha256. It was built for
	  glibc 2.17 and generic x86-64, and needs libstdc++.

	  The pronunciation data (espeak-ng-data) is not installed here:
	  it is part of the voice pack on /models, which the voice checks
	  before loading.

	  Licences: GPL-3.0-or-later (piper-phonemize and espeak-ng),
	  installed to /usr/share/licenses/piper-phonemize.

	  https://github.com/csukuangfj/piper-phonemize

comment "piper-phonemize needs an x86-64 glibc toolchain with C++ and threads"
	depends on !BR2_x86_64 || !BR2_TOOLCHAIN_USES_GLIBC || !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
