config BR2_PACKAGE_CORTEX
	bool "cortex"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_9
	depends on BR2_USE_WCHAR
	help
	  The being's language model server: llama.cpp's llama-server,
	  built for the laptop's CPU. Buildroot's own llama-cpp package
	  leaves the instruction set to llama.cpp's cross-compile
	  defaults, which turn on AVX2. That binary would crash on an
	  Ivy Bridge CPU, so this package sets every flag itself.

	  https://github.com/ggml-org/llama.cpp
