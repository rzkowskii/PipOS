# PipOS power settings for the MacBookPro9,2 (plan task 2.9).
#
# USB autosuspend only for devices that are idle most of the time: the
# FaceTime HD camera, the Bluetooth module (no Bluetooth stack is built, so
# it is always idle) and the IR receiver. The keyboard and trackpad are
# never autosuspended: a suspended keyboard loses the first key press, and
# Pip's attention key and Esc must always work.
#
# The IDs are those Apple used on 2012 MacBook Pros. Check them against the
# hardware report's `lsusb`-style listing (task 1.18) on the first boot; an
# ID that does not match simply leaves that device at the kernel default.

ACTION!="add", GOTO="being_power_end"
SUBSYSTEM!="usb", GOTO="being_power_end"
ENV{DEVTYPE}!="usb_device", GOTO="being_power_end"
ATTR{idVendor}!="05ac", GOTO="being_power_end"

# Never: the internal keyboard and trackpad (ANSI, ISO and JIS variants).
ATTR{idProduct}=="0252|0253|0254", TEST=="power/control", ATTR{power/control}="on", GOTO="being_power_end"

# FaceTime HD camera (UVC). being-eyes opens it only with the owner's consent.
ATTR{idProduct}=="8509", TEST=="power/control", ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="2000"
# Bluetooth USB host controller (BCM20702).
ATTR{idProduct}=="821d|828c", TEST=="power/control", ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="2000"
# Apple IR receiver.
ATTR{idProduct}=="8242", TEST=="power/control", ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="2000"
# TODO(power-live-test, step bt-hid-autosuspend): the Bluetooth module's HID
# proxy devices (820a keyboard, 820b mouse) stay powered and keep the EHCI bus
# awake. Enable only if that step HELPS (0.5 W or 5 points of PC6+PC7):
#ATTR{idProduct}=="820a|820b", TEST=="power/control", ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="2000"

LABEL="being_power_end"

# Every power_supply change uevent (the adapter plugged in or pulled out;
# the Smart Battery's pack going or coming: the sbs driver keeps BAT0 listed
# and only flips its present file) touches a stamp. bodycare and the
# brainstem read the battery through the embedded controller only every
# 10-60 s; they stat this stamp every pass and read the battery at once
# when it changes. No EC traffic: the uevent comes from the driver's notify.
SUBSYSTEM=="power_supply", ACTION=="change", RUN+="/bin/touch /run/being-power-changed"

# A USB flash stick (the Try stick among them) is not a spinning disk, but
# its bridge says it is: the Try stick read queue/rotational=1 (25 November
# 2026). Flag it as flash, so the block layer and tools (lsblk, the hardware
# report) treat it as such. Only removable USB disks: a USB hard disk
# reports removable=0 and keeps its flag. SUBSYSTEMS (a parent match), not
# ID_BUS, which 60-persistent-storage.rules sets only after this file.
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", SUBSYSTEMS=="usb", ATTR{removable}=="1", ATTR{queue/rotational}=="1", ATTR{queue/rotational}="0"

# TODO(power-live-test, steps usb-hosts-auto and driverless-pci-auto):
# runtime PM for the EHCI and xHCI controllers (8086:1e2d, 1e26, 1e31), and
# for the currently unbound devices (FireWire 11c1:5901 and the Thunderbolt
# bridge 8086:1513), plus the sdhci-pci-bound SD reader 14e4:16bc. Unbound
# PCI devices stay in D0 under runtime PM, and this firmware's root ports need
# pcie_port_pm=force for D3. The bound reader also needs insertion/removal and
# resume qualification, so nothing is shipped until the measured step HELPS.
# The candidate rules would be:
#ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x8086", ATTR{device}=="0x1e2d|0x1e26|0x1e31", TEST=="power/control", ATTR{power/control}="auto"
#ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x11c1", ATTR{device}=="0x5901", TEST=="power/control", ATTR{power/control}="auto"
#ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x14e4", ATTR{device}=="0x16bc", TEST=="power/control", ATTR{power/control}="auto"
#ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x8086", ATTR{device}=="0x1513", TEST=="power/control", ATTR{power/control}="auto"

# SATA link power management: the kernel already defaults to
# med_power_with_dipm (CONFIG_SATA_MOBILE_LPM_POLICY=3, read from the
# resolved 23 Nov 2026 laptop kernel config; tests/test_os_image.py checks
# that linux.config never overrides it), so nothing is written here.
#
# HDA codec power saving stays off while awake (a click and a 1-2 s wake-up
# on the first sound). bodycare may set
# /sys/module/snd_hda_intel/parameters/power_save while Pip sleeps, once it
# has been measured on the laptop.
