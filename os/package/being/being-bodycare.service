[Unit]
Description=Being: bodycare (charge limit, fan floor and CPU caps)
# The only writer of power and thermal state (plan task 2.8). It starts in
# observe mode and publishes body.care; writes are enabled by the owner's
# choice, never by default. On any exit the factory fan minimum, CPU limits
# and turbo are restored by ExecStopPost.
After=being-brainstem.service
StartLimitIntervalSec=0
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/etc/being/env
# The restore journal (each control's original value, saved before it is
# changed) must be writable under ProtectSystem=strict, where all of /run is
# read-only: it lives in the unit's own runtime directory. Preserved, so a
# restart after a crash still knows the factory values.
RuntimeDirectory=being-bodycare
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/being-bodycare --bus ${BEING_BUS} --journal /run/being-bodycare/restore.json
ExecStopPost=/usr/bin/being-bodycare --restore --journal /run/being-bodycare/restore.json
WatchdogSec=30s
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30s
TimeoutStopSec=10
# Its own work is tiny; it must still run when the model has every core.
Nice=-5
# It writes sysfs power knobs (applesmc, hwmon, intel_pstate, the HDA power
# save parameter) and, only in battery-out mode, /dev/cpu/*/msr. Nothing else.
# ProtectKernelTunables is deliberately off: it would make /sys read-only.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_RAWIO
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/mind
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-cpu/msr rw
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
MemoryMax=32M

[Install]
WantedBy=multi-user.target
