[Unit]
Description=Being: local ears and voice
ConditionPathExists=!/mind/.being-restore-in-progress
ConditionPathExists=!/sys/firmware/qemu_fw_cfg/by_name/opt/beingos/serial/raw
RequiresMountsFor=/mind
After=being-brainstem.service sound.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/being/env
Environment=PYTHONPATH=/usr/lib/being PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m mind.voice
Restart=always
RestartSec=1
TimeoutStopSec=5
# The ears and voice come first for the CPU, with the face and the brainstem:
# a busy model must never make them stutter.
CPUWeight=1000
# The voice pings from its own event loop (mind/sd_notify.py), so an ear that
# hangs is restarted rather than left deaf.
WatchdogSec=30s
NotifyAccess=main
# The ears and voice need the sound card and the bus, and no network.
# The QEMU lab also gives them a virtio serial microphone port
# (mind/mic_port.py) and has them load snd-aloop (mind/voice.py), so the
# virtio ports stay allowed and kernel modules stay loadable. With cgroup BPF
# in the kernel (linux.config) DevicePolicy= is enforced, not advisory.
NoNewPrivileges=yes
ProtectHome=yes
PrivateNetwork=yes
IPAddressDeny=any
DevicePolicy=closed
DeviceAllow=char-alsa rw
DeviceAllow=char-virtio-portsdev rw
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
