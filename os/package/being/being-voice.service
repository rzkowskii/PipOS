[Unit]
Description=Being: local speech recognition and voice
ConditionPathExists=!/mind/.being-restore-in-progress
ConditionPathExists=!/sys/firmware/qemu_fw_cfg/by_name/opt/beingos/serial/raw
ConditionPathExists=!/run/being/mic-policy-breach
RequiresMountsFor=/mind
After=being-brainstem.service being-ears.service sound.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/being/env
Environment=PYTHONPATH=/usr/lib/being PYTHONUNBUFFERED=1
Environment=BEING_EARS_SOCKET=/run/being/ears.sock
ExecStart=/usr/bin/python3 -m mind.voice
Restart=always
RestartSec=1
TimeoutStopSec=5
# The ears and voice come first for the CPU, with the face and the brainstem:
# a busy model must never make them stutter.
CPUWeight=1000
# The voice pings from its own event loop (mind/sd_notify.py), so an ear that
# hangs is restarted rather than left deaf.
WatchdogSec=30s
NotifyAccess=main
# Playback, mixer control and the bus, but never microphone capture. The QEMU
# lab also gives the voice a virtio serial microphone port
# (mind/mic_port.py), so the virtio ports stay allowed. With cgroup BPF in
# the kernel (linux.config) DevicePolicy= is enforced.
NoNewPrivileges=yes
LimitCORE=0
CapabilityBoundingSet=
ProtectHome=yes
PrivateNetwork=yes
IPAddressDeny=any
DevicePolicy=closed
DeviceAllow=/dev/snd/controlC0 rw
DeviceAllow=/dev/snd/pcmC0D0p rw
# A second-card/QEMU playback endpoint, without either card's capture node.
DeviceAllow=/dev/snd/controlC1 rw
DeviceAllow=/dev/snd/pcmC1D0p rw
DeviceAllow=/dev/snd/timer rw
DeviceAllow=char-virtio-portsdev rw
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
