[Unit]
Description=Being: local camera presence and gaze
RequiresMountsFor=/mind
After=being-brainstem.service
ConditionPathExists=/mind/camera.enabled

[Service]
EnvironmentFile=/etc/being/env
Environment=PYTHONPATH=/usr/lib/being PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m mind.eyes
Restart=on-failure
RestartSec=3
TimeoutStopSec=3
Nice=10
NoNewPrivileges=yes
LimitCORE=0
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/mind
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-video4linux rw
PrivateNetwork=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
