[Unit]
Description=Being: mind
ConditionPathExists=!/mind/.being-restore-in-progress
StartLimitIntervalSec=0
RequiresMountsFor=/mind
After=being-brainstem.service being-cortex.service

[Service]
EnvironmentFile=/etc/being/env
Environment=PYTHONPATH=/usr/lib/being PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m mind --bus ${BEING_BUS} --config /etc/being --mind-dir ${BEING_MIND} \
    --cortex http://127.0.0.1:8080
Restart=always
RestartSec=1
# On the way down it saves the conversation and the model's cache.
TimeoutStopSec=20
# Light limits only: the mind still sets the clock, reaches the cortex and,
# in Internet mode, the weather service (plan task 3.14 moves that fetch to
# its own sandboxed helper).
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
