[Unit]
Description=Being: face
# Read the saved look before the first frame. Do not require a healthy mind
# partition to show the face, and never wait for the mind process.
DefaultDependencies=no
After=mind.mount
# An organ is restarted for as long as it takes. systemd must never give up.
StartLimitIntervalSec=0
Conflicts=shutdown.target
Before=shutdown.target

[Service]
EnvironmentFile=/etc/being/env
# Draw straight to the screen: there is no window system.
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=BEING_LOCAL_SETUP=1
Environment=PYTHONPATH=/usr/lib/being
# A writable shader cache (ProtectHome hides /root/.cache), kept in RAM across
# face restarts so a restarted face does not compile its shaders again.
Environment=MESA_SHADER_CACHE_DIR=/run/being/mesa MESA_SHADER_CACHE_MAX_SIZE=16M
RuntimeDirectory=being/mesa
RuntimeDirectoryPreserve=yes
ExecCondition=/usr/libexec/being-screen-mode face
ExecStartPre=-/usr/bin/python3 -m mind.look
ExecStart=/usr/bin/being-face --fullscreen --bus ${BEING_BUS}
Restart=always
RestartSec=300ms
# Every frame tells systemd the face is alive (at least 5 frames a second,
# even dark); a frame loop stuck for 5 s is restarted.
WatchdogSec=5s
NotifyAccess=main
TimeoutAbortSec=2s
# The eyes never wait for the model or the night's work.
CPUWeight=1000
# The face owns video and the keyboard. Setup runs in its own systemd unit.
NoNewPrivileges=yes
LimitCORE=0
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-fb rw
DeviceAllow=char-input r
DeviceAllow=char-tty rw
ProtectHome=yes
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=sysinit.target
