[Unit]
Description=Being: boot-local working context storage
ConditionPathExists=!/mind/.being-restore-in-progress
RequiresMountsFor=/mind

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PYTHONPATH=/usr/lib/being PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m mind.context_storage
TimeoutStartSec=20s
RuntimeDirectory=being-context
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ReadWritePaths=/mind /run/being-context
