#!/bin/sh
# Bind an installed boot's mounts and update service to its own partition IDs.
set -efu

IFS= read -r cmdline </proc/cmdline
installed=
trying=
try_active=
seen=
invalid=
esp= a= b= models= mind= mind_crypt= root= slot= fstab= gpt_auto=
trial=
local_text=

for arg in $cmdline; do
    key=${arg%%=*}
    value=${arg#*=}
    case "$key" in
        nomodeset) local_text=yes; continue ;;
        being.try)
            trying=yes
            if [ "$value" = 1 ]; then try_active=yes; fi
            continue ;;
        being.trial)
            trial=$value
            continue ;;
        being.installed) field=installed; installed=$value ;;
        being.esp) field=esp; esp=$value ;;
        being.slot_a) field=a; a=$value ;;
        being.slot_b) field=b; b=$value ;;
        being.models) field=models; models=$value ;;
        being.mind) field=mind; mind=$value ;;
        being.mind_crypt)
            field=mind_crypt
            [ "$value" = 1 ] || invalid=yes
            mind_crypt=$value ;;
        root) field=root; root=$value ;;
        rauc.slot) field=slot; slot=$value ;;
        fstab) field=fstab; fstab=$value ;;
        systemd.gpt_auto) field=gpt_auto; gpt_auto=$value ;;
        *) continue ;;
    esac
    case " $seen " in *" $field "*) invalid=yes ;; esac
    seen="$seen $field"
done

case " $seen " in *" installed "*) ;; *) exit 0 ;; esac
# Try's own generator takes precedence and keeps state off disk.
[ -z "$try_active" ] || exit 0
early=${2:?Missing early systemd generator directory}
requires="$early/local-fs.target.requires"
wants="$early/local-fs.target.wants"
binding=being-installed-bind.service
mkdir -p "$requires" "$wants"

# write_mount NAME WHAT TYPE OPTIONS [UNITS] [requires|wants]
# Only what the being cannot live without is required by local-fs.target. A
# damaged boot-state or model partition must not drop the boot into
# emergency mode (there is no login there): the face still comes up and says
# it is unwell.
write_mount() {
    cat > "$early/$1.mount" <<EOF
[Unit]
Before=local-fs.target
Requires=${5:-}
After=${5:-}

[Mount]
What=$2
Where=/$1
Type=$3
Options=$4
EOF
    if [ "${6:-requires}" = wants ]; then
        ln -sf "../$1.mount" "$wants/$1.mount"
    else
        ln -sf "../$1.mount" "$requires/$1.mount"
    fi
}

deny() {
    for unit in bootstate.mount mind.mount models.mount rauc.service being-boot-health.service being-trial-reboot.service; do
        ln -sf /dev/null "$early/$unit"
    done
    # The root is read-only and fstab=no: without this /var stays read-only.
    write_mount var tmpfs tmpfs mode=0755,nosuid,nodev
    # A trial slot that cannot prove who it is never confirms itself: reboot,
    # so the boot loader spends one of its attempts and falls back.
    if [ "$trial" = 1 ]; then
        mkdir -p "$early/multi-user.target.wants"
        cat > "$early/being-installed-deny-reboot.service" <<EOF
[Unit]
Description=Reboot a PipOS trial slot whose installed identity is invalid

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --no-block reboot
EOF
        ln -sf ../being-installed-deny-reboot.service "$early/multi-user.target.wants/being-installed-deny-reboot.service"
    fi
    printf '%s\n' 'being-installed-generator: invalid installed boot identity; disk mounts and updates disabled.' >&2
    exit 0
}

[ -z "$invalid$trying" ] && [ "$installed" = 1 ] && [ "$fstab" = no ] && [ "$gpt_auto" = no ] || deny

validated=
for id in "$esp" "$a" "$b" "$models" "$mind"; do
    printf '%s\n' "$id" | LC_ALL=C grep -Eq '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' || deny
    [ "$id" != 00000000-0000-0000-0000-000000000000 ] || deny
    case " $validated " in *" $id "*) deny ;; esac
    validated="$validated $id"
done

case "$slot" in A) active=$a ;; B) active=$b ;; *) deny ;; esac
[ "$root" = "PARTUUID=$active" ] || deny

template=/usr/share/being/installed-rauc.conf
grep -qxF 'device=/dev/disk/by-partuuid/SLOT_A_UUID' "$template" &&
    grep -qxF 'device=/dev/disk/by-partuuid/SLOT_B_UUID' "$template" || deny

devices=
for id in $validated; do
    unit=$(systemd-escape --path --suffix=device "/dev/disk/by-partuuid/$id") || deny
    devices="$devices $unit"
done

mind_path="/dev/disk/by-partuuid/$mind"
unlock=
mount_path=$mind_path
if [ "$mind_crypt" = 1 ]; then
    unlock=being-mind-crypt.service
    mount_path=/dev/mapper/pipos-mind
    mapper=$(systemd-escape --path --suffix=device "$mount_path") || deny
    mkdir -p "$early/$mapper.d"
    cat > "$early/$mapper.d/being-mind-crypt.conf" <<EOF
[Unit]
JobTimeoutSec=infinity
JobRunningTimeoutSec=infinity
EOF
    console=/usr/bin/being-console
    if [ "$local_text" = yes ]; then console=; fi
    cat > "$early/$unlock" <<EOF
[Unit]
Description=Unlock PipOS mind volume
DefaultDependencies=no
Requires=$binding
Wants=systemd-udev-settle.service
After=$binding systemd-udev-settle.service
Before=local-fs-pre.target
Conflicts=umount.target
Before=umount.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=SDL_VIDEODRIVER=kmsdrm PYTHONPATH=/usr/lib/being BEING_CONSOLE_PRIVATE=1
LimitCORE=0
ExecStart=${console:+$console }/usr/bin/python3 -m mind.mind_encryption unlock $mind
ExecStop=/usr/sbin/cryptsetup close pipos-mind
TimeoutStartSec=infinity
EOF
    if [ "$local_text" = yes ]; then
        cat >> "$early/$unlock" <<EOF
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
EOF
    fi
    ln -sf "../$unlock" "$requires/$unlock"
fi
check=$(systemd-escape --path --template=systemd-fsck@.service "$mount_path") || deny
esp_path="/dev/disk/by-partuuid/$esp"
esp_check=$(systemd-escape --path --template=systemd-fsck@.service "$esp_path") || deny
mkdir -p "$early/being-installed" "$early/rauc.service.d" "$early/$check.d" "$early/$esp_check.d" \
    "$early/bootstate.mount.d"
config="$early/being-installed/rauc.conf"
sed -e "s/SLOT_A_UUID/$a/g" -e "s/SLOT_B_UUID/$b/g" "$template" > "$config"

cat > "$early/$binding" <<EOF
[Unit]
Description=Verify PipOS installed disk identity
DefaultDependencies=no
Requires=$devices
After=systemd-udev-trigger.service $devices
Before=local-fs-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PYTHONPATH=/usr/lib/being PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m mind.install_binding
EOF

# The fsck job can write to its device. Verify the disk before it can run.
for unit in "$check" "$esp_check"; do
    cat > "$early/$unit.d/being-installed.conf" <<EOF
[Unit]
Requires=$binding
After=$binding
EOF
done
if [ -n "$unlock" ]; then
    mkdir -p "$early/$check.d"
    cat > "$early/$check.d/being-mind-crypt.conf" <<EOF
[Unit]
Requires=$unlock
After=$unlock
EOF
fi

# A power cut can leave the FAT boot-state volume dirty. The kernel then
# remounts it read-only on the first bad chain and RAUC and the boot health
# check can no longer record slot state. Repair it before mounting. A failed
# check still mounts the volume so the confirmed slot keeps running.
cat > "$early/bootstate.mount.d/being-esp-fsck.conf" <<EOF
[Unit]
Wants=$esp_check
After=$esp_check
EOF

write_mount var tmpfs tmpfs mode=0755,nosuid,nodev
write_mount bootstate "$esp_path" vfat rw,umask=0077,nodev,nosuid,noexec,nofail "$binding" wants
write_mount models "/dev/disk/by-partuuid/$models" ext4 ro,noload,noatime,nodev,nosuid,noexec,nofail "$binding" wants
write_mount mind "$mount_path" ext4 rw,noatime,nodev,nosuid,noexec,discard "$binding $check${unlock:+ $unlock}"

# Logs that survive a reboot: the journal lives on /mind/log/journal (64 MB,
# 30 days; 50-being-journal.conf) and every boot adds a line to boots.txt.
# None of this is required: without it the journal simply stays in RAM.
cat > "$early/being-boot-record.service" <<EOF
[Unit]
Description=Keep PipOS logs on the mind partition
DefaultDependencies=no
Requires=mind.mount
After=mind.mount
Before=var-log-journal.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/being-boot-record
EOF
cat > "$early/var-log-journal.mount" <<EOF
[Unit]
Description=PipOS journal on the mind partition
Requires=being-boot-record.service var.mount
After=being-boot-record.service var.mount
Before=systemd-journal-flush.service

[Mount]
What=/mind/log/journal
Where=/var/log/journal
Type=none
Options=bind,nodev,nosuid,noexec
EOF
ln -sf ../var-log-journal.mount "$wants/var-log-journal.mount"

cat > "$early/rauc.service.d/being-installed.conf" <<EOF
[Unit]
RequiresMountsFor=/bootstate /mind /models

[Service]
ExecStart=
ExecStart=/usr/bin/rauc --conf=$config --mount=/run/rauc/mnt service
EOF
