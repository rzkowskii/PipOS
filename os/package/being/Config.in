config BR2_PACKAGE_BEING
	bool "being"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_SDL2_KMSDRM
	depends on BR2_PACKAGE_PYTHON3_SQLITE
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_JPEG
	help
	  The being's organs: the face, the brainstem and the mind, with
	  the systemd units that start them at boot.

comment "being needs SDL2 with the KMS/DRM video driver, and Python 3 with SQLite"
	depends on !BR2_PACKAGE_SDL2_KMSDRM || !BR2_PACKAGE_PYTHON3_SQLITE

config BR2_PACKAGE_BEING_LAB_BODY
	bool "lab body"
	depends on BR2_PACKAGE_BEING
	help
	  For images that run in a virtual machine with no microphone or
	  speakers yet: the second serial line (ttyS1) becomes its ears
	  and voice. What is typed there is heard; what it says is
	  printed there. Not for the laptop.

config BR2_PACKAGE_BEING_LAN_MAINTENANCE
	bool "paired LAN maintenance"
	default y
	depends on BR2_PACKAGE_BEING
	depends on BR2_PACKAGE_OPENSSH_SERVER
	help
	  The owner-enrolled, key-only LAN observation and time-limited
	  development logins: being-lab-access, its two systemd units
	  and the restricted being-observe account. Nothing listens
	  until the owner runs being-lab-access enroll. The default
	  laptop image leaves this out; the owner opts in at build time.
