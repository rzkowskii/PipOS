# PipOS for x86-64: the 2012 MacBook Pro and the QEMU lab machine.

# Every binary is built for the laptop's CPU. Ivy Bridge has AVX but not AVX2,
# so nothing in the image may use AVX2.
BR2_x86_64=y
BR2_x86_ivybridge=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# A UTF-8 locale (glibc's C.UTF-8, about 0.4 MB). Without one, Python stays
# in the C locale, and espeak-ng inside piper-phonemize then reads accented
# letters by name ("Café" as "caf e acute") in the natural voice. Python
# switches to C.UTF-8 by itself once it exists (PEP 538).
BR2_GENERATE_LOCALE="C.UTF-8"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_CCACHE=y
BR2_CCACHE_DIR="/work/ccache"
# One cache serves every tree; the default 5 GB evicts the LLVM build.
BR2_CCACHE_INITIAL_SETUP="--max-size=40G"

# Our own fixes to other people's packages live in os/patches/.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BEINGOS_PATH)/patches"
# Every download must match a known hash, including the custom kernel
# version (os/patches/linux/linux.hash) and the cortex source.
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# System
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="being"
BR2_TARGET_GENERIC_ISSUE=""
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_TZ_INFO=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# The login manager is what turns the power button into a shutdown.
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SYSTEMD_ANALYZE=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BEINGOS_PATH)/board/beingos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BEINGOS_PATH)/board/beingos/post-image.sh"
# No setuid or setgid file in the image (BusyBox is setuid by default).
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_BEINGOS_PATH)/board/beingos/post-fakeroot.sh"

# Kernel: 6.18 long-term
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.64"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BEINGOS_PATH)/board/beingos/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Disk image: UEFI, GRUB, GPT
BR2_TARGET_ROOTFS_SQUASHFS=y
# This SquashFS is also read by GRUB, which supports gzip.
BR2_TARGET_ROOTFS_SQUASHFS4_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux fat squash4 part_gpt normal efi_gop loadenv regexp test echo serial"
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_MTOOLS=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_DBUS=y
BR2_PACKAGE_HOST_RAUC=y

# Owner-configured Wi-Fi. The simulated radio is a separate lab option.
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_NFTABLES=y
# Lets systemd enforce SystemCallFilter=, RestrictAddressFamilies= and
# RestrictNamespaces= in the organ and workshop sandboxes. Without it they
# are skipped silently.
BR2_PACKAGE_LIBSECCOMP=y
# The standard listener is masked. PipOS starts its own listeners after enrolment.
BR2_PACKAGE_OPENSSH=y
# BR2_PACKAGE_OPENSSH_CLIENT is not set
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y

# Graphics: the laptop's GPU driver (crocus), and a software renderer
# (llvmpipe) for machines with no usable GPU, such as the lab's.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y

# The organs. Rust comes prebuilt for the build host.
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_HOST_RUST_BIN=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_ZLIB=y
# OpenSSL supplies WPA2 key derivation and HTTPS weather lookups.
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_CA_CERTIFICATES=y
# Offline Keep PDF extraction; Qt support stays disabled.
BR2_PACKAGE_POPPLER=y
BR2_PACKAGE_POPPLER_UTILS=y
BR2_PACKAGE_BEING=y
BR2_PACKAGE_BEING_BACKUP_AGE=y
BR2_PACKAGE_CRYPTSETUP=y
# This image is for the lab: the second serial line stands in for a voice.
BR2_PACKAGE_BEING_LAB_BODY=y

# The language model server, built for this CPU.
BR2_PACKAGE_CORTEX=y

# The local audio loop.
BR2_PACKAGE_POCKETSPHINX=y
# The voice engines after the wake word: Silero VAD, Moonshine and Piper.
# Prebuilt; ONNX Runtime picks its CPU kernels at run time, and
# lab/sherpa_avx_smoke.py runs it on an Ivy Bridge CPU model (AVX, no AVX2).
BR2_PACKAGE_SHERPA_ONNX=y
BR2_PACKAGE_PIPER_PHONEMIZE=y
# Installed as the release archive has them (about 7 MB more), so a smoke
# verdict, pinned to the archive bytes it tested, matches the installed bytes
# and the voice may load Moonshine (mind/voice_engines.sherpa_smoke_passed).
BR2_STRIP_EXCLUDE_FILES="libsherpa-onnx-c-api.so libonnxruntime.so"
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
BR2_PACKAGE_FLITE=y

# Checking the mind partition at boot (e2fsck).
BR2_PACKAGE_E2FSPROGS=y
