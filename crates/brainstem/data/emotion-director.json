 "lexicon": [
  {"rule": "thanks-start", "kind": "start", "after": "break", "or_next": ["for", "again"], "refuse_next": ["to", "for nothing", "so", "a lot of"], "any": ["thank you", "thanks"], "family": "thanks", "strength": 0.55},
